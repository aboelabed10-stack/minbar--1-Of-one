<!DOCTYPE html><html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0"><title>لوحة الأستاذ | منبر ون</title><style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,Tahoma,sans-serif;
    background:#071126;
    color:white;
    min-height:100vh;
    overflow-x:hidden;
}

/* العناصر المتحركة */
.floating{
    position:fixed;
    top:-60px;
    z-index:0;
    opacity:.25;
    font-size:22px;
    animation:fall 10s linear infinite;
    pointer-events:none;
}

.f1{right:10%;animation-duration:9s;}
.f2{right:28%;animation-duration:13s;animation-delay:2s;}
.f3{right:48%;animation-duration:11s;animation-delay:4s;}
.f4{right:68%;animation-duration:15s;animation-delay:1s;}
.f5{right:88%;animation-duration:12s;animation-delay:5s;}

@keyframes fall{
    from{
        transform:translateY(-70px) rotate(0deg);
    }
    to{
        transform:translateY(110vh) rotate(360deg);
    }
}

/* التخطيط */
.page{
    position:relative;
    z-index:2;
    display:flex;
    min-height:100vh;
}

/* القائمة */
.sidebar{
    width:210px;
    position:fixed;
    right:0;
    top:0;
    bottom:0;
    background:#0b1832;
    border-left:1px solid #1c3155;
    padding:15px 12px;
    z-index:10;
}

.logo{
    display:flex;
    align-items:center;
    gap:8px;
    margin-bottom:25px;
    padding:5px;
}

.logoIcon{
    width:40px;
    height:40px;
    border-radius:12px;
    background:linear-gradient(135deg,#00bfff,#7c4dff);
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:20px;
}

.logoText{
    font-size:13px;
    font-weight:bold;
}

.logoText small{
    display:block;
    color:#7d91ae;
    font-size:7px;
    margin-top:3px;
}

.menuTitle{
    color:#617997;
    font-size:7px;
    margin:0 8px 8px;
}

.menu{
    display:flex;
    flex-direction:column;
    gap:5px;
}

.menu button{
    width:100%;
    border:0;
    background:transparent;
    color:#8da2be;
    border-radius:11px;
    padding:8px;
    display:flex;
    align-items:center;
    gap:8px;
    font-size:8px;
    cursor:pointer;
    transition:.2s;
}

.menu button:hover,
.menu button.active{
    background:#14294c;
    color:white;
}

.icon{
    width:28px;
    height:28px;
    border-radius:9px;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:13px;
    flex-shrink:0;
}

.blue{background:#087eaf;}
.purple{background:#7547b8;}
.orange{background:#b66b19;}
.green{background:#13816d;}
.red{background:#a73c59;}
.cyan{background:#2865a7;}
.pink{background:#85469e;}
.gray{background:#496044;}

.homeButton{
    position:absolute;
    bottom:15px;
    right:12px;
    left:12px;
    border:1px solid #203858;
    background:#101f3c;
    color:#91a4be;
    padding:9px;
    border-radius:10px;
    font-size:8px;
    cursor:pointer;
}

/* المحتوى */
.content{
    margin-right:210px;
    width:calc(100% - 210px);
    padding:20px;
}

.header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:18px;
}

.header h1{
    font-size:20px;
}

.header p{
    color:#7186a5;
    font-size:8px;
    margin-top:5px;
}

.teacher{
    background:#0d1d38;
    border:1px solid #1d3456;
    border-radius:12px;
    padding:7px 10px;
    display:flex;
    align-items:center;
    gap:8px;
    font-size:8px;
}

.teacherIcon{
    width:34px;
    height:34px;
    border-radius:10px;
    background:linear-gradient(135deg,#ff963b,#d9437d);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:15px;
}

/* الإحصائيات */
.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
    margin-bottom:15px;
}

.stat{
    background:#0c1c37;
    border:1px solid #1b3355;
    border-radius:15px;
    padding:14px;
}

.statIcon{
    width:30px;
    height:30px;
    border-radius:9px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:13px;
    margin-bottom:8px;
}

.stat strong{
    display:block;
    font-size:20px;
}

.stat span{
    color:#7389a7;
    font-size:7px;
}

/* البطاقات */
.panel{
    background:#0b1a34;
    border:1px solid #1a3152;
    border-radius:16px;
    padding:15px;
    margin-bottom:13px;
}

.panelTitle{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:12px;
}

.panelTitle h2{
    font-size:12px;
}

.panelTitle span{
    color:#7187a5;
    font-size:7px;
}

/* الإضافة */
.quick{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:8px;
}

.quick button{
    border:0;
    color:white;
    padding:13px 8px;
    border-radius:12px;
    text-align:right;
    cursor:pointer;
    transition:.2s;
}

.quick button:hover{
    transform:translateY(-3px);
}

.q1{background:#075f85;}
.q2{background:#633a98;}
.q3{background:#945513;}
.q4{background:#106653;}

.quickIcon{
    width:29px;
    height:29px;
    border-radius:8px;
    background:rgba(255,255,255,.15);
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:7px;
}

.quick h3{
    font-size:8px;
}

.quick p{
    color:#d2deea;
    font-size:6px;
    margin-top:4px;
}

/* البحث */
.search{
    margin-bottom:10px;
}

.search input{
    width:100%;
    height:38px;
    background:#07152b;
    border:1px solid #1d3657;
    border-radius:10px;
    color:white;
    padding:0 12px;
    outline:none;
    font-size:8px;
}

/* العناصر */
.item{
    background:#08172e;
    border:1px solid #172d4c;
    border-radius:10px;
    padding:9px;
    display:flex;
    align-items:center;
    gap:9px;
    margin-bottom:7px;
}

.itemIcon{
    width:32px;
    height:32px;
    border-radius:9px;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:14px;
}

.itemInfo{
    flex:1;
}

.itemInfo strong{
    display:block;
    font-size:8px;
}

.itemInfo span{
    display:block;
    color:#7186a4;
    font-size:6px;
    margin-top:4px;
}

.btn{
    border:0;
    border-radius:7px;
    padding:6px 8px;
    color:white;
    font-size:6px;
    cursor:pointer;
}

.watch{background:#24579b;}
.delete{background:#7c2942;}

/* الأقسام */
.section{
    display:none;
}

.section.active{
    display:block;
}

/* نافذة */
.modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.72);
    display:none;
    justify-content:center;
    align-items:center;
    padding:20px;
    z-index:100;
}

.modal.active{
    display:flex;
}

.modalBox{
    width:100%;
    max-width:450px;
    background:#101f3c;
    border:1px solid #284568;
    border-radius:18px;
    padding:18px;
}

.modalHead{
    display:flex;
    justify-content:space-between;
    margin-bottom:15px;
}

.modalHead h2{
    font-size:13px;
}

.close{
    border:0;
    background:none;
    color:white;
    font-size:20px;
    cursor:pointer;
}

.field{
    margin-bottom:10px;
}

.field label{
    display:block;
    color:#8195b0;
    font-size:7px;
    margin-bottom:5px;
}

.field input,
.field textarea{
    width:100%;
    background:#07152b;
    border:1px solid #1d3657;
    border-radius:9px;
    color:white;
    padding:10px;
    outline:none;
    font-size:8px;
}

.field textarea{
    min-height:70px;
}

.save{
    width:100%;
    border:0;
    border-radius:9px;
    height:39px;
    background:linear-gradient(135deg,#08a9dc,#7449db);
    color:white;
    font-size:8px;
    cursor:pointer;
}

/* الهاتف */
@media(max-width:800px){

    .sidebar{
        width:60px;
        padding:10px 6px;
    }

    .logoText,
    .menuTitle,
    .menu button span,
    .homeButton{
        display:none;
    }

    .logo{
        justify-content:center;
    }

    .menu button{
        justify-content:center;
        padding:6px;
    }

    .content{
        margin-right:60px;
        width:calc(100% - 60px);
        padding:12px;
    }

    .stats{
        grid-template-columns:repeat(2,1fr);
    }

    .quick{
        grid-template-columns:repeat(2,1fr);
    }

    .teacher{
        display:none;
    }
}
</style></head><body><!-- رموز تنزل من الأعلى --><div class="floating f1">✏️</div>
<div class="floating f2">📚</div>
<div class="floating f3">⭐</div>
<div class="floating f4">📐</div>
<div class="floating f5">🧮</div><div class="page"><!-- القائمة الجانبية --><aside class="sidebar"><div class="logo">
    <div class="logoIcon">∑</div>
    <div class="logoText">
        منبر ون
        <small>لوحة الأستاذ</small>
    </div>
</div><div class="menuTitle">لوحة التحكم</div><div class="menu"><button class="active" onclick="showSection('dashboard',this)">
    <div class="icon blue">📊</div>
    <span>الرئيسية</span>
</button><button onclick="showSection('lessons',this)">
    <div class="icon purple">🎥</div>
    <span>الحصص</span>
</button><button onclick="showSection('summaries',this)">
    <div class="icon orange">📚</div>
    <span>الملخصات</span>
</button><button onclick="showSection('tests',this)">
    <div class="icon green">📝</div>
    <span>الاختبارات</span>
</button><button onclick="showSection('rooms',this)">
    <div class="icon red">💬</div>
    <span>الرومات</span>
</button><button onclick="showSection('students',this)">
    <div class="icon cyan">👨‍🎓</div>
    <span>الطلاب</span>
</button><button onclick="showSection('notifications',this)">
    <div class="icon pink">🔔</div>
    <span>الإشعارات</span>
</button><button onclick="showSection('settings',this)">
    <div class="icon gray">⚙️</div>
    <span>الإعدادات</span>
</button></div><button class="homeButton" onclick="location.href='index.html'">
🏠 العودة للموقع
</button></aside><!-- المحتوى --><main class="content"><div class="header"><div>
    <h1>لوحة تحكم الأستاذ 👨‍🏫</h1>
    <p>إدارة المحتوى التعليمي في منبر ون</p>
</div><div class="teacher">
    <div class="teacherIcon">👨‍🏫</div>
    <div>
        الأستاذ
        <br>
        <small>مدير المحتوى</small>
    </div>
</div></div><!-- الرئيسية --><section id="dashboard" class="section active"><div class="stats"><div class="stat">
    <div class="statIcon blue">🎥</div>
    <strong id="lessonCount">0</strong>
    <span>الحصص</span>
</div><div class="stat">
    <div class="statIcon purple">📚</div>
    <strong id="summaryCount">0</strong>
    <span>الملخصات</span>
</div><div class="stat">
    <div class="statIcon orange">📝</div>
    <strong id="testCount">0</strong>
    <span>الاختبارات</span>
</div><div class="stat">
    <div class="statIcon green">👨‍🎓</div>
    <strong>0</strong>
    <span>الطلاب</span>
</div></div><div class="panel"><div class="panelTitle">
    <h2>⚡ إضافة سريعة</h2>
    <span>أضف محتوى جديدًا</span>
</div><div class="quick"><button class="q1" onclick="openModal('حصة')">
    <div class="quickIcon">🎥</div>
    <h3>إضافة حصة</h3>
    <p>فيديو ودرس جديد</p>
</button><button class="q2" onclick="openModal('ملخص')">
    <div class="quickIcon">📚</div>
    <h3>إضافة ملخص</h3>
    <p>ملخص وقوانين</p>
</button><button class="q3" onclick="openModal('اختبار')">
    <div class="quickIcon">📝</div>
    <h3>إضافة اختبار</h3>
    <p>اختبار للطلاب</p>
</button><button class="q4" onclick="openModal('روم')">
    <div class="quickIcon">💬</div>
    <h3>إضافة روم</h3>
    <p>روم للدراسة</p>
</button></div>
</div><div class="panel"><div class="panelTitle">
    <h2>🆕 أحدث الحصص</h2>
    <span>آخر المحتوى</span>
</div><div id="latestLessons">
    <div class="item">
        <div class="itemIcon blue">🎥</div>
        <div class="itemInfo">
            <strong>جاري تحميل الحصص...</strong>
            <span>انتظر قليلًا</span>
        </div>
    </div>
</div></div></section><!-- الحصص --><section id="lessons" class="section"><div class="panel"><div class="panelTitle">
    <h2>🎥 إدارة الحصص</h2>
    <button class="btn watch" onclick="openModal('حصة')">➕ إضافة</button>
</div><div class="search">
    <input id="searchLessons" placeholder="🔎 ابحث عن حصة..." oninput="searchLessons()">
</div><div id="allLessons">
    <div class="item">
        <div class="itemInfo">
            <strong>جاري تحميل الحصص...</strong>
        </div>
    </div>
</div></div></section><!-- الملخصات --><section id="summaries" class="section"><div class="panel"><div class="panelTitle">
    <h2>📚 إدارة الملخصات</h2>
    <button class="btn watch" onclick="openModal('ملخص')">➕ إضافة</button>
</div><div class="item">
    <div class="itemIcon orange">📚</div>
    <div class="itemInfo">
        <strong>قسم الملخصات</strong>
        <span>يمكنك إضافة ملخصاتك هنا</span>
    </div>
</div></div></section><!-- الاختبارات --><section id="tests" class="section"><div class="panel"><div class="panelTitle">
    <h2>📝 إدارة الاختبارات</h2>
    <button class="btn watch" onclick="openModal('اختبار')">➕ إضافة</button>
</div><div class="item">
    <div class="itemIcon green">📝</div>
    <div class="itemInfo">
        <strong>قسم الاختبارات</strong>
        <span>يمكنك إضافة الاختبارات هنا</span>
    </div>
</div></div></section><!-- الرومات --><section id="rooms" class="section"><div class="panel"><div class="panelTitle">
    <h2>💬 إدارة الرومات</h2>
    <button class="btn watch" onclick="openModal('روم')">➕ إضافة</button>
</div><div class="item">
    <div class="itemIcon red">💬</div>
    <div class="itemInfo">
        <strong>قسم الرومات</strong>
        <span>الرومات التعليمية ستظهر هنا</span>
    </div>
</div></div></section><!-- الطلاب --><section id="students" class="section"><div class="panel"><div class="panelTitle">
    <h2>👨‍🎓 الطلاب</h2>
</div><div class="item">
    <div class="itemIcon cyan">👨‍🎓</div>
    <div class="itemInfo">
        <strong>إدارة الطلاب</strong>
        <span>سيتم ربط الطلاب لاحقًا بتسجيل الدخول</span>
    </div>
</div></div></section><!-- الإشعارات --><section id="notifications" class="section"><div class="panel"><div class="panelTitle">
    <h2>🔔 الإشعارات</h2>
</div><div class="item">
    <div class="itemIcon pink">🔔</div>
    <div class="itemInfo">
        <strong>لا توجد إشعارات</strong>
        <span>ستظهر الإشعارات الجديدة هنا</span>
    </div>
</div></div></section><!-- الإعدادات --><section id="settings" class="section"><div class="panel"><div class="panelTitle">
    <h2>⚙️ الإعدادات</h2>
</div><div class="item">
    <div class="itemIcon gray">⚙️</div>
    <div class="itemInfo">
        <strong>إعدادات المنصة</strong>
        <span>سنضيف الإعدادات المتقدمة لاحقًا</span>
    </div>
</div></div></section></main>
</div><!-- نافذة الإضافة --><div id="modal" class="modal"><div class="modalBox"><div class="modalHead">
    <h2 id="modalTitle">إضافة محتوى</h2>
    <button class="close" onclick="closeModal()">×</button>
</div><div class="field">
    <label>العنوان</label>
    <input id="title" placeholder="اكتب عنوان المحتوى">
</div><div class="field">
    <label>الوحدة</label>
    <input id="unit" placeholder="مثال: الوحدة الأولى">
</div><div class="field">
    <label>الوصف</label>
    <textarea id="description" placeholder="اكتب وصفًا مختصرًا"></textarea>
</div><div class="field">
    <label>رابط الفيديو أو المحتوى</label>
    <input id="url" placeholder="ضع الرابط هنا">
</div><button class="save" onclick="saveDemo()">
💾 حفظ
</button></div>
</div><script>

/* التنقل بين الأقسام */

function showSection(id,button){

    document.querySelectorAll(".section").forEach(function(section){
        section.classList.remove("active");
    });

    document.getElementById(id).classList.add("active");

    document.querySelectorAll(".menu button").forEach(function(btn){
        btn.classList.remove("active");
    });

    button.classList.add("active");
}


/* فتح نافذة الإضافة */

function openModal(type){

    document.getElementById("modalTitle").innerText =
        "➕ إضافة " + type;

    document.getElementById("modal").classList.add("active");
}


/* إغلاق النافذة */

function closeModal(){

    document.getElementById("modal").classList.remove("active");
}


/* حفظ مؤقت للواجهة */

function saveDemo(){

    var title =
        document.getElementById("title").value.trim();

    if(title === ""){

        alert("اكتب عنوان المحتوى أولًا");

        return;
    }

    alert("تم حفظ المحتوى بنجاح 🎉");

    document.getElementById("title").value="";
    document.getElementById("unit").value="";
    document.getElementById("description").value="";
    document.getElementById("url").value="";

    closeModal();
}


/* تحميل بيانات Supabase */

var SUPABASE_URL =
"https://vugnptbvkitokwqxulla.supabase.co";

var SUPABASE_KEY =
"sb_publishable__WJDSewc6JN6XTM6czk11Q_lgON6Chj";


async function getData(table){

    try{

        var response =
        await fetch(
            SUPABASE_URL +
            "/rest/v1/" +
            table +
            "?select=*",
            {
                headers:{
                    "apikey":SUPABASE_KEY,
                    "Authorization":"Bearer " + SUPABASE_KEY
                }
            }
        );

        if(!response.ok){
            return [];
        }

        return await response.json();

    }catch(error){

        console.log(error);

        return [];
    }
}


/* تحميل لوحة التحكم */

async function loadDashboard(){

    var lessons = await getData("lessons");
    var summaries = await getData("summaries");
    var tests = await getData("tests");

    document.getElementById("lessonCount").innerText =
        lessons.length;

    document.getElementById("summaryCount").innerText =
        summaries.length;

    document.getElementById("testCount").innerText =
        tests.length;


    var latest =
        document.getElementById("latestLessons");

    var all =
        document.getElementById("allLessons");

    latest.innerHTML="";
    all.innerHTML="";


    if(lessons.length === 0){

        latest.innerHTML =
        '<div class="item">' +
        '<div class="itemIcon blue">📚</div>' +
        '<div class="itemInfo">' +
        '<strong>لا توجد حصص بعد</strong>' +
        '<span>ابدأ بإضافة أول حصة</span>' +
        '</div></div>';

        all.innerHTML =
        '<div class="item">' +
        '<div class="itemInfo">' +
        '<strong>لا توجد حصص</strong>' +
        '</div></div>';

        return;
    }


    lessons.slice(0,5).forEach(function(lesson){

        latest.innerHTML +=
        '<div class="item">' +
        '<div class="itemIcon blue">🎥</div>' +
        '<div class="itemInfo">' +
        '<strong>' +
        escapeHTML(lesson.title || "بدون عنوان") +
        '</strong>' +
        '<span>' +
        escapeHTML(lesson.unit || "حصة تعليمية") +
        '</span>' +
        '</div></div>';

    });


    lessons.forEach(function(lesson){

        all.innerHTML +=
        '<div class="item">' +
        '<div class="itemIcon blue">🎥</div>' +
        '<div class="itemInfo">' +
        '<strong>' +
        escapeHTML(lesson.title || "بدون عنوان") +
        '</strong>' +
        '<span>' +
        escapeHTML(lesson.unit || "حصة تعليمية") +
        '</span>' +
        '</div>' +
        (lesson.video_url ?
        '<button class="btn watch" onclick="window.open(\'' +
        encodeURI(lesson.video_url) +
        '\',\'_blank\')">▶️ مشاهدة</button>'
        : '') +
        '</div>';

    });

}


/* البحث */

function searchLessons(){

    var text =
        document.getElementById("searchLessons")
        .value
        .toLowerCase();

    document.querySelectorAll("#allLessons .item")
    .forEach(function(item){

        var value =
            item.innerText.toLowerCase();

        item.style.display =
            value.includes(text)
            ? "flex"
            : "none";

    });
}


/* حماية النص */

function escapeHTML(text){

    return String(text)
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");
}


/* تشغيل */

loadDashboard();

</script></body>
</html>
